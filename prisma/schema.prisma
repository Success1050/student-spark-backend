  appointedById  String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([schoolId, isActive])
  @@index([userId, isActive])
  @@map("sug_office_holders")
}

model SugElection {
  id           String                 @id @default(uuid())
  schoolId     String
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId       String
  role         SugRoleConfig          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  title        String
  description  String?                @db.Text
  scopeTier    String                 @default("SUG_CENTRAL") // SUG_CENTRAL | FACULTY | DEPARTMENT | COURSE_REP
  unitId       String?
  unit         AcademicUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status       String                 @default("UPCOMING") // UPCOMING | LIVE | CLOSED
  startsAt     DateTime?
  endsAt       DateTime?
  createdById  String?
  candidates   SugElectionCandidate[]
  votes        SugElectionVote[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([schoolId, status])
  @@map("sug_elections")
}

model SugElectionCandidate {
  id             String            @id @default(uuid())
  electionId     String
  election       SugElection       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  studentId      String?
  student        User?             @relation("SugCandidateUser", fields: [studentId], references: [id], onDelete: SetNull)
  fullName       String
  photoUrl       String?
  departmentName String
  facultyName    String?
  levelCode      String            @default("200L")
  manifesto      String?           @db.Text
  voteCount      Int               @default(0)
  isApproved     Boolean           @default(true)
  votes          SugElectionVote[]
  createdAt      DateTime          @default(now())

  @@index([electionId, voteCount])
  @@map("sug_election_candidates")
}

model SugElectionVote {
  id          String               @id @default(uuid())
  electionId  String
  election    SugElection          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   SugElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterId     String
  voter       User                 @relation("SugVoterUser", fields: [voterId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())

  @@unique([electionId, voterId])
  @@index([electionId, candidateId])
  @@map("sug_election_votes")
}

model SugPost {
  id                 String   @id @default(uuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?    @relation("SugPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorRoleTitle    String   @default("SUG Executive")
  category           String   @default("UPDATE") // UPDATE | ANNOUNCEMENT | SCHOLARSHIP | VACANCY | EVENT | INTERNAL_EXCO | FINANCE_REPORT
  title              String
  body               String   @db.Text
  amountOrStipend    String?
  deadline           String?
  externalLink       String?
  isInternalOnly     Boolean  @default(false)
  isNationwidePublic Boolean  @default(false)
  isPinned           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([schoolId, isInternalOnly, createdAt])
  @@index([isNationwidePublic, createdAt])
  @@map("sug_posts")
}

model SugWelfareTicket {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User     @relation("SugWelfareReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  category        String   @default("WELFARE") // WELFARE | BURSARY | HOSTEL_POWER | ACADEMIC_APPEAL | SAFETY
  title           String
  description     String   @db.Text
  status          String   @default("OPEN") // OPEN | IN_REVIEW | RESOLVED
  assignedToRole  String?
  resolutionNote  String?  @db.Text
  isPublicSummary Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([reporterId])
  @@map("sug_welfare_tickets")
}

model SugLeaderMessage {
  id           String    @id @default(uuid())
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  senderId     String
  sender       User      @relation("SugMsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User      @relation("SugMsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  isNationwide Boolean   @default(false)
  message      String    @db.Text
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("sug_leader_messages")
}

model SugEndorsementNominee {
  id               String               @id @default(uuid())
  schoolId         String
  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId           String
  role             SugRoleConfig        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  nomineeUserId    String
  nominee          User                 @relation("SugNomineeUser", fields: [nomineeUserId], references: [id], onDelete: Cascade)
  nominatedById    String
  nominatedBy      User                 @relation("SugNominatorUser", fields: [nominatedById], references: [id], onDelete: Cascade)
  unitId           String?
  departmentId     String?
  fullName         String
  photoUrl         String?
  departmentName   String
  facultyName      String?
  levelCode        String               @default("200L")
  manifesto        String?              @db.Text
  endorsementCount Int                  @default(1)
  status           String               @default("PENDING_ENDORSEMENT") // PENDING_ENDORSEMENT | APPROVED_FOR_ELECTION | REJECTED
  approvedById     String?
  endorsements     SugEndorsementVote[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([roleId, nomineeUserId])
  @@index([schoolId, roleId, endorsementCount])
  @@map("sug_endorsement_nominees")
}

model SugEndorsementVote {
  id        String                @id @default(uuid())
  roleId    String
  role      SugRoleConfig         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  nomineeId String
  nominee   SugEndorsementNominee @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User                  @relation("SugEndorserUser", fields: [voterId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@unique([roleId, voterId])
  @@index([nomineeId])
  @@map("sug_endorsement_votes")
}
