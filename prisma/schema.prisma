generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  STUDENT
  TEACHER
  SCHOOL_ADMIN
  SCHOOL_FINANCE
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  PENDING_FIRST_LOGIN
}

enum SubscriptionPlanType {
  free
  premium
  pro
}

enum BillingCycle {
  monthly
  yearly
}

enum InstitutionType {
  SECONDARY
  POLYTECHNIC
  UNIVERSITY
  OTHER
}

enum SchoolModule {
  CLASS_NOTES
  ATTENDANCE
  CBT_ASSESSMENTS
  AUTO_GRADING_REPORT_CARDS
  FEE_COLLECTION
  STUDY_COMMUNITIES
  ELIBRARY_MARKETPLACE
  AI_STUDY_TOOLS
  GAMES_ARCADE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxCategory {
  REFERRAL_COMMISSION
  SCHOOL_REFERRAL_BOUNTY
  MARKETPLACE_SALE
  WITHDRAWAL
  REFUND
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum MarketplaceItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarketplaceVisibilityScope {
  COURSE_OR_CLASS
  DEPARTMENT_OR_FACULTY
  SCHOOL_WIDE
  PUBLIC_MARKETPLACE
}

enum GameMode {
  QUIZ_BATTLE_1V1
  CONCEPT_SCRAMBLE
  SPEED_MATH
  MEMORY_MATCH
  SCHOLAR_LADDER
}

enum GameMatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================================
// 1. SUPERADMIN PLATFORM CONFIGURATION & SUBSCRIPTION PLANS
// ============================================================================

model PlatformConfig {
  id                               String   @id @default(uuid())
  key                              String   @unique @default("GLOBAL")
  marketplacePlatformPercent       Float    @default(20.0)
  studentReferralCommissionPercent Float    @default(20.0)
  schoolReferralBountyPercent      Float    @default(10.0)
  schoolFeeTransactionFeePercent   Float    @default(1.5)
  minimumWithdrawalKobo            Int      @default(100000)
  updatedAt                        DateTime @updatedAt
  createdAt                        DateTime @default(now())

  @@map("platform_configs")
}

model SubscriptionPlan {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  price       Int           @default(0)
  currency    String        @default("NGN")
  interval    String        @default("monthly")
  isActive    Boolean       @default(true)
  features    PlanFeature[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("subscription_plans")
}

model PlanFeature {
  id        String           @id @default(uuid())
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   String
  createdAt DateTime         @default(now())

  @@map("plan_features")
}

model SchoolSubscriptionTier {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  description       String?
  monthlyPriceNaira Int            @default(0)
  yearlyPriceNaira  Int            @default(0)
  maxStudentSeats   Int            @default(200)
  enabledModules    SchoolModule[]
  isActive          Boolean        @default(true)
  schools           School[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("school_subscription_tiers")
}

// ============================================================================
// 2. MULTI-TENANT SCHOOL PORTAL MODELS
// ============================================================================

model School {
  id                                 String                  @id @default(uuid())
  name                               String
  slug                               String                  @unique
  schoolCode                         String                  @unique
  institutionType                    InstitutionType         @default(SECONDARY)
  logoUrl                            String?
  primaryColor                       String                  @default("#EA580C")
  secondaryColor                     String                  @default("#1E293B")
  address                            String?
  contactEmail                       String?
  contactPhone                       String?
  tierId                             String?
  tier                               SchoolSubscriptionTier? @relation(fields: [tierId], references: [id])
  enabledModules                     SchoolModule[]
  maxSeats                           Int                     @default(200)
  subscriptionStart                  DateTime?
  subscriptionEnd                    DateTime?
  isActive                           Boolean                 @default(true)
  customMarketplaceCommissionPercent Float?
  defaultMinAttendancePercent        Float                   @default(75.0)
  terminologyConfig                  Json?
  masterSecretKey                    String?                 @unique
  secretKeyCreatedAt                 DateTime?
  academicContinuityMode             String                  @default("ACTIVE")
  strikeNoticeTitle                  String?
  strikeNoticeBody                   String?
  strikePausedAt                     DateTime?
  continuityUpdatedAt                DateTime?

  academicUnits             AcademicUnit[]
  departments               Department[]
  memberships               Membership[]
  teacherProfiles           TeacherProfile[]
  studentProfiles           StudentProfile[]
  auditLogs                 AuditLog[]
  users                     User[]
  academicSessions          AcademicSession[]
  classes                   SchoolClass[]
  subjects                  SchoolSubject[]
  notes                     Note[]
  quizzes                   Quiz[]
  pastQuestions             PastQuestion[]
  attendanceSessions        AttendanceSession[]
  assessmentConfigs         AssessmentConfig[]
  subjectGrades             StudentSubjectGrade[]
  reportCards               TerminalReportCard[]
  feeItems                  SchoolFeeItem[]
  marketplaceItems          MarketplaceItem[]
  communities               StudyCommunity[]
  notifications             Notification[]
  calendarEvents            SchoolCalendarEvent[]
  courseRepAssignments      CourseRepAssignment[]
  courseRepBroadcasts       CourseRepBroadcast[]
  courseRepAttendanceSlips  CourseRepAttendanceSlip[]
  departmentalPastQuestions DepartmentalPastQuestion[]
  sugOnboardingCampaigns    SugOnboardingCampaign[]
  sugRoleConfigs            SugRoleConfig[]
  sugOfficeHolders          SugOfficeHolder[]
  sugElections              SugElection[]
  sugPosts                  SugPost[]
  sugWelfareTickets         SugWelfareTicket[]
  sugLeaderMessages         SugLeaderMessage[]
  sugEndorsementNominees    SugEndorsementNominee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model AcademicSession {
  id        String         @id @default(uuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isCurrent Boolean        @default(false)
  terms     AcademicTerm[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([schoolId])
  @@map("academic_sessions")
}

model AcademicTerm {
  id                  String                @id @default(uuid())
  sessionId           String
  session             AcademicSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name                String
  isCurrent           Boolean               @default(false)
  isEnabled           Boolean               @default(false)
  isClosed            Boolean               @default(false)
  startDate           DateTime?
  endDate             DateTime?
  nextTermResumesDate DateTime?
  subjectGrades       StudentSubjectGrade[]
  reportCards         TerminalReportCard[]
  feeItems            SchoolFeeItem[]
  calendarEvents      SchoolCalendarEvent[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([sessionId])
  @@map("academic_terms")
}

enum CalendarBreakType {
  HOLIDAY
  MID_TERM
  OTHER
}

model SchoolCalendarEvent {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId      String
  term        AcademicTerm      @relation(fields: [termId], references: [id], onDelete: Cascade)
  title       String
  type        CalendarBreakType @default(HOLIDAY)
  startDate   DateTime
  endDate     DateTime
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId, termId])
  @@map("school_calendar_events")
}

model AcademicUnit {
  id           String       @id @default(uuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  code         String
  unitType     String       @default("FACULTY")
  deanOrHeadId String?
  description  String?
  departments      Department[]
  sugRoleConfigs   SugRoleConfig[]
  sugOfficeHolders SugOfficeHolder[]
  sugElections     SugElection[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("academic_units")
}

model Department {
  id          String           @id @default(uuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        AcademicUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name        String
  code        String
  hodId       String?
  classes                   SchoolClass[]
  subjects                  SchoolSubject[]
  students                  StudentProfile[]
  teachers                  TeacherProfile[]
  courseRepAssignments      CourseRepAssignment[]
  departmentalPastQuestions DepartmentalPastQuestion[]
  sugOnboardingCampaigns    SugOnboardingCampaign[]
  sugRoleConfigs            SugRoleConfig[]
  sugOfficeHolders          SugOfficeHolder[]
  sugElections              SugElection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId, unitId])
  @@map("departments")
}

model SchoolClass {
  id                 String                @id @default(uuid())
  schoolId           String
  school             School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name               String
  levelCode          String?
  termOrSemester     String?
  inviteCode           String                @unique
  formTeacherId        String?
  minAttendancePercent Int                   @default(75)
  students             User[]
  subjects           SchoolSubject[]
  enrollments        ClassEnrollment[]
  teacherProfiles    TeacherProfile[]
  studentProfiles    StudentProfile[]
  notes              Note[]
  quizzes            Quiz[]
  attendanceSessions AttendanceSession[]
  subjectGrades      StudentSubjectGrade[]
  reportCards        TerminalReportCard[]
  marketplaceItems         MarketplaceItem[]
  teacherHistory           ClassTeacherAssignmentHistory[]
  courseRepAssignments     CourseRepAssignment[]
  courseRepBroadcasts      CourseRepBroadcast[]
  courseRepAttendanceSlips CourseRepAttendanceSlip[]
  sugOnboardingCampaigns   SugOnboardingCampaign[]
  sugOfficeHolders         SugOfficeHolder[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([schoolId])
  @@index([departmentId])
  @@map("school_classes")
}

model SchoolSubject {
  id                   String                @id @default(uuid())
  schoolId             String
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId              String
  schoolClass          SchoolClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  departmentId         String?
  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teacherId            String?
  teacher              User?                 @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: SetNull)
  assignedTeachers     TeacherProfile[]
  name                 String
  courseCode           String
  creditUnits          Int?
  minAttendancePercent Float                 @default(75.0)
  notes                Note[]
  quizzes              Quiz[]
  attendanceSessions   AttendanceSession[]
  assessmentConfig     AssessmentConfig?
  subjectGrades            StudentSubjectGrade[]
  marketplaceItems         MarketplaceItem[]
  courseRepAssignments     CourseRepAssignment[]
  courseRepBroadcasts      CourseRepBroadcast[]
  courseRepAttendanceSlips CourseRepAttendanceSlip[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([schoolId, classId])
  @@index([departmentId])
  @@map("school_subjects")
}

model ClassEnrollment {
  id          String      @id @default(uuid())
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime    @default(now())

  @@unique([classId, studentId])
  @@map("class_enrollments")
}

// ============================================================================
// 3. USERS, AUTHENTICATION & PUSH TOKENS
// ============================================================================

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  passwordHash      String?
  fullName          String?
  username          String?
  avatarUrl         String?
  role              UserRole             @default(STUDENT)
  schoolId          String?
  school            School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classId           String?
  schoolClass       SchoolClass?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentCode       String?
  loginId           String?
  mustChangePassword Boolean             @default(false)
  plan              SubscriptionPlanType @default(free)
  billingCycle      BillingCycle?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  streak            Int                  @default(0)
  longestStreak     Int                  @default(0)
  lastCompletedDate String?
  courses           String[]             @default([])
  motivation        String?
  xpPoints          Int                  @default(0)
  referralCode      String               @unique
  referredById      String?
  referredBy        User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]               @relation("UserReferrals")
  notifyInApp       Boolean              @default(true)
  notifyPush        Boolean              @default(true)
  notifyEmail       Boolean              @default(true)

  refreshTokens        RefreshToken[]
  devicePushTokens     DevicePushToken[]
  usageTracking        UsageTracking[]
  userCourses          UserCourse[]
  notes                Note[]
  quizzes              Quiz[]
  pastQuestions        PastQuestion[]
  practiceQuestionSets PracticeQuestionSet[]
  studyPlans           StudyPlan[]
  studyTasks           StudyTask[]
  taughtSubjects       SchoolSubject[]       @relation("TeacherSubjects")
  classEnrollments     ClassEnrollment[]
  attendanceRecords    AttendanceRecord[]
  subjectGrades        StudentSubjectGrade[]
  reportCards          TerminalReportCard[]
  feePayments          SchoolFeePayment[]
  wallet               Wallet?
  referralsMade        Referral[]            @relation("ReferrerRelation")
  referralReceived     Referral?             @relation("ReferredUserRelation")
  withdrawalRequests   WithdrawalRequest[]
  marketplaceItems     MarketplaceItem[]
  marketplacePurchases MarketplacePurchase[]
  createdCommunities   StudyCommunity[]
  communityMemberships CommunityMember[]
  communityMessages    CommunityMessage[]
  hostedGames          GameMatch[]           @relation("HostUserGames")
  opponentGames        GameMatch[]           @relation("OpponentUserGames")
  notifications        Notification[]
  memberships          Membership[]
  teacherProfile       TeacherProfile?
  studentProfile       StudentProfile?
  cbtSubmissions            CbtSubmission[]
  auditLogs                 AuditLog[]
  loginOtps                 LoginOtp[]
  courseRepAssignments      CourseRepAssignment[]      @relation("CourseRepStudent")
  delegatedCourseReps       CourseRepAssignment[]      @relation("CourseRepDelegator")
  courseRepBroadcasts       CourseRepBroadcast[]
  createdAttendanceSlips    CourseRepAttendanceSlip[]  @relation("SlipCreator")
  signedAttendanceSlips     CourseRepAttendanceSlipEntry[]
  uploadedDepartmentalPqs   DepartmentalPastQuestion[] @relation("DeptPqUploader")
  sugOfficeHolders          SugOfficeHolder[]          @relation("SugHolderUser")
  sugElectionCandidacies    SugElectionCandidate[]     @relation("SugCandidateUser")
  sugElectionVotes          SugElectionVote[]          @relation("SugVoterUser")
  sugPosts                  SugPost[]                  @relation("SugPostAuthor")
  sugWelfareTickets         SugWelfareTicket[]         @relation("SugWelfareReporter")
  sugMessagesSent           SugLeaderMessage[]         @relation("SugMsgSender")
  sugMessagesReceived       SugLeaderMessage[]         @relation("SugMsgRecipient")
  sugEndorsementsReceived   SugEndorsementNominee[]    @relation("SugNomineeUser")
  sugNominationsMade        SugEndorsementNominee[]    @relation("SugNominatorUser")
  sugEndorsementVotes       SugEndorsementVote[]       @relation("SugEndorserUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, role])
  @@index([referralCode])
  @@index([loginId])
  @@map("users")
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role               UserRole         @default(STUDENT)
  loginId            String?
  status             MembershipStatus @default(ACTIVE)
  isDefault          Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([schoolId, loginId])
  @@unique([schoolId, userId])
  @@index([userId])
  @@index([schoolId, role])
  @@map("memberships")
}

model TeacherProfile {
  id                   String          @id @default(uuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId             String
  school               School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId              String?
  departmentId         String?
  department           Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title                String?         @default("Teacher")
  specialization       String?
  educationLevel       String?
  qualificationDetails String?
  phoneNumber          String?
  gender               String?
  address              String?
  employmentType       String?
  yearsOfExperience    Int?
  dateHired            DateTime?
  handlesAllSubjects   Boolean         @default(false)
  assignedClasses      SchoolClass[]
  assignedSubjects     SchoolSubject[]
  classHistory         ClassTeacherAssignmentHistory[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([schoolId, staffId])
  @@index([schoolId])
  @@index([staffId])
  @@map("teacher_profiles")
}

model StudentProfile {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId            String
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  matricOrAdmissionNo String?
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classId             String?
  schoolClass         SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  level                String?      @default("100L")
  age                  Int?
  guardianName         String?
  guardianRelationship String?
  guardianEmail        String?
  guardianPhone        String?
  cgpa                 Float        @default(0.0)
  totalCredits         Int          @default(0)
  isCourseRep          Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([schoolId, matricOrAdmissionNo])
  @@index([schoolId, departmentId])
  @@index([schoolId, classId])
  @@index([matricOrAdmissionNo])
  @@map("student_profiles")
}

model ClassTeacherAssignmentHistory {
  id               String         @id @default(uuid())
  schoolId         String
  classId          String
  schoolClass      SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  roleLabel        String?
  subjectSummary   String?
  assignedAt       DateTime       @default(now())
  unassignedAt     DateTime?

  @@index([schoolId, classId])
  @@index([teacherProfileId])
  @@map("class_teacher_assignment_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName  String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, action, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model UserCourse {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCode String
  color      String   @default("#6366F1")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("user_courses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model DevicePushToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String   @unique
  platform      String   @default("android")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("device_push_tokens")
}

// ============================================================================
// 4. CORE STUDENT COMPANION & AI MODELS
// ============================================================================

model UsageTracking {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  actionDate String
  count      Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([userId, actionType, actionDate])
  @@map("usage_tracking")
}

model Note {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId             String?
  school               School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classId              String?
  schoolClass          SchoolClass?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId            String?
  subject              SchoolSubject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title                String
  summary              String                @db.Text
  courseCode           String                @default("General")
  color                String                @default("#EA580C")
  listsOfTopic         Json                  @default("[]")
  fileUrl              String?
  isClassNote          Boolean               @default(false)
  quizzes              Quiz[]
  practiceQuestionSets PracticeQuestionSet[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([schoolId, classId])
  @@map("notes")
}

model Quiz {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId             String?
  note               Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  schoolId           String?
  school             School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classId            String?
  schoolClass        SchoolClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId          String?
  subject            SchoolSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title              String
  courseCode         String         @default("General")
  color              String         @default("#6366F1")
  questions          Json
  score              Float          @default(0)
  percentage         Float          @default(0)
  totalMarks         Int            @default(0)
  totalPossibleMarks Int            @default(10)
  correctCount       Int            @default(0)
  completed          Boolean        @default(false)
  timeLimit          Int            @default(600)
  isClassCbt         Boolean        @default(false)
  dueDate            DateTime?
  cbtSubmissions     CbtSubmission[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([schoolId, classId])
  @@map("quizzes")
}

model CbtSubmission {
  id                 String   @id @default(uuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId          String
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score              Float    @default(0)
  percentage         Float    @default(0)
  totalMarks         Int      @default(0)
  totalPossibleMarks Int      @default(100)
  answersJson        Json?
  submittedAt        DateTime @default(now())

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("cbt_submissions")
}

model PastQuestion {
  id        String              @id @default(uuid())
  userId    String
